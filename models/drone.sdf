<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="drone">
    <!-- El dron no es estático, se mueve -->
    <static>false</static>
    <link name="base_link">
      <!-- Posición y orientación inicial del link -->
      <pose>0 0 0 0 0 0</pose>
      <!-- Propiedades inerciales -->
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.04</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <!-- Colisión: se define una caja simple -->
      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.2</size>
          </box>
        </geometry>
      </collision>
      <!-- Visual: representación gráfica de la caja -->
      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>
    <!--
      Opcionalmente, puedes incluir plugins para controlar el dron.
      Por ejemplo, si tienes un plugin para simular la dinámica o la teleoperación,
      lo puedes agregar aquí.
    -->
  </model>
</sdf>
