<launch>

    <!-- Publicar transform fijo: map -> world -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="static_tf_map_to_world"
        args="0 0 0 0 0 0 map world" />
    
  <node pkg="tf2_ros" type="static_transform_publisher" name="velodyne_tf"
      args="0 0 0 0 0 0 base_link velodyne_base_link" />

  <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_base_link" 
      args="0 0 0 0 0 0 map base_link" />

  

  <!-- Lanzar Gazebo con el mundo del hospital -->
  <arg name="world_path" default="$(find bim2ros)/worlds/hospital.world"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_path)" />
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!-- Spawn del quadrotor -->
  <include file="$(find hector_quadrotor_gazebo)/launch/spawn_quadrotor.launch">
    <arg name="model" value="$(find hector_quadrotor_description)/urdf/quadrotor_hokuyo_utm30lx.gazebo.xacro"/>
    <arg name="x" value="30"/>
    <arg name="y" value="-5"/>
    <arg name="z" value="0.5"/>
  </include>

 

  <!-- Visualización -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find hector_quadrotor_demo)/rviz_cfg/outdoor_flight.rviz"/>
</launch>
